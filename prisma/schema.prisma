generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model bodega {
  id                    Int                     @id @default(autoincrement())
  nombre                String                  @db.VarChar(150)
  direccion             String                  @db.VarChar(255)
  movimiento_inventario movimiento_inventario[]
  recepcion_mercaderia  recepcion_mercaderia[]
  stock                 stock[]
  venta                 venta[]
}

model categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @db.VarChar(100)
  descripcion String?    @db.VarChar(255)
  producto    producto[]
}

model cliente {
  id                  Int                      @id @default(autoincrement())
  tipo_identificacion tipo_identificacion_enum
  identificacion      String?                  @db.VarChar(20)
  razon_social        String                   @db.VarChar(150)
  email               String?                  @db.VarChar(150)
  direccion           String?                  @db.VarChar(255)
  venta               venta[]
}

model comprobante_electronico {
  id                  Int                     @id @default(autoincrement())
  venta_id            Int                     @unique(map: "uq_comprobante_venta")
  clave_acceso        String                  @unique(map: "uq_comprobante_clave_acceso") @db.VarChar(49)
  numero_autorizacion String?                 @db.VarChar(100)
  estado              estado_comprobante_enum @default(PENDIENTE)
  fecha_autorizacion  DateTime?               @db.Timestamp(6)
  xml_firmado_url     String?                 @db.VarChar(500)
  ride_pdf_url        String?                 @db.VarChar(500)
  venta               venta                   @relation(fields: [venta_id], references: [id], onDelete: Cascade, map: "fk_comprobante_venta")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalle_recepcion {
  id                   Int                  @id @default(autoincrement())
  recepcion_id         Int
  producto_id          Int
  cantidad_paquetes    Int?
  peso_libras          Decimal?             @db.Decimal(10, 3)
  costo_unitario       Decimal?             @db.Decimal(10, 2)
  producto             producto             @relation(fields: [producto_id], references: [id], map: "fk_detrecepcion_producto")
  recepcion_mercaderia recepcion_mercaderia @relation(fields: [recepcion_id], references: [id], onDelete: Cascade, map: "fk_detrecepcion_recepcion")

  @@index([producto_id], map: "idx_detrecepcion_producto")
  @@index([recepcion_id], map: "idx_detrecepcion_recepcion")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalle_venta {
  id                Int      @id @default(autoincrement())
  venta_id          Int
  producto_id       Int
  cantidad_paquetes Int?
  peso_libras       Decimal? @db.Decimal(10, 3)
  precio_aplicado   Decimal  @db.Decimal(10, 2)
  subtotal          Decimal  @db.Decimal(12, 2)
  producto          producto @relation(fields: [producto_id], references: [id], map: "fk_detventa_producto")
  venta             venta    @relation(fields: [venta_id], references: [id], onDelete: Cascade, map: "fk_detventa_venta")

  @@index([producto_id], map: "idx_detventa_producto")
  @@index([venta_id], map: "idx_detventa_venta")
}

model movimiento_inventario {
  id              Int                        @id @default(autoincrement())
  producto_id     Int
  bodega_id       Int
  tipo_movimiento tipo_movimiento_enum
  cantidad        Decimal                    @db.Decimal(10, 3)
  referencia_id   Int?
  referencia_tipo referencia_movimiento_enum
  motivo          String?                    @db.VarChar(255)
  fecha           DateTime                   @default(now()) @db.Timestamp(6)
  usuario_id      Int
  bodega          bodega                     @relation(fields: [bodega_id], references: [id], map: "fk_movimiento_bodega")
  producto        producto                   @relation(fields: [producto_id], references: [id], map: "fk_movimiento_producto")
  usuario         usuario                    @relation(fields: [usuario_id], references: [id], map: "fk_movimiento_usuario")

  @@index([bodega_id], map: "idx_movimiento_bodega")
  @@index([producto_id, fecha], map: "idx_movimiento_producto")
  @@index([usuario_id], map: "idx_movimiento_usuario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model producto {
  id                    Int                     @id @default(autoincrement())
  codigo_barras         String                  @unique(map: "uq_producto_codigo_barras") @db.VarChar(100)
  nombre                String                  @db.VarChar(150)
  descripcion           String?                 @db.VarChar(255)
  categoria_id          Int
  proveedor_id          Int
  tipo_venta            tipo_venta_enum
  unidades_por_paquete  Int?
  precio_paquete        Decimal?                @db.Decimal(10, 2)
  precio_libra          Decimal?                @db.Decimal(10, 2)
  precio_mayorista      Decimal?                @db.Decimal(10, 2)
  stock_minimo          Decimal                 @default(0) @db.Decimal(10, 2)
  iva_tarifa            Decimal                 @default(15.00) @db.Decimal(5, 2)
  activo                Boolean                 @default(true)
  detalle_recepcion     detalle_recepcion[]
  detalle_venta         detalle_venta[]
  movimiento_inventario movimiento_inventario[]
  categoria             categoria               @relation(fields: [categoria_id], references: [id], map: "fk_producto_categoria")
  proveedor             proveedor               @relation(fields: [proveedor_id], references: [id], map: "fk_producto_proveedor")
  stock                 stock[]

  @@index([categoria_id], map: "idx_producto_categoria")
  @@index([proveedor_id], map: "idx_producto_proveedor")
}

model proveedor {
  id                   Int                    @id @default(autoincrement())
  razon_social         String                 @db.VarChar(150)
  ruc                  String                 @unique(map: "uq_proveedor_ruc") @db.VarChar(13)
  telefono             String?                @db.VarChar(30)
  email                String?                @db.VarChar(150)
  direccion            String?                @db.VarChar(255)
  producto             producto[]
  recepcion_mercaderia recepcion_mercaderia[]
}

model recepcion_mercaderia {
  id                Int                 @id @default(autoincrement())
  proveedor_id      Int
  usuario_id        Int
  bodega_id         Int
  fecha             DateTime            @default(now()) @db.Timestamp(6)
  numero_documento  String?             @db.VarChar(100)
  detalle_recepcion detalle_recepcion[]
  bodega            bodega              @relation(fields: [bodega_id], references: [id], map: "fk_recepcion_bodega")
  proveedor         proveedor           @relation(fields: [proveedor_id], references: [id], map: "fk_recepcion_proveedor")
  usuario           usuario             @relation(fields: [usuario_id], references: [id], map: "fk_recepcion_usuario")

  @@index([bodega_id], map: "idx_recepcion_bodega")
  @@index([proveedor_id], map: "idx_recepcion_proveedor")
  @@index([usuario_id], map: "idx_recepcion_usuario")
}

model stock {
  id                  Int      @id @default(autoincrement())
  producto_id         Int
  bodega_id           Int
  cantidad_disponible Decimal  @default(0) @db.Decimal(10, 2)
  actualizado_en      DateTime @default(now()) @db.Timestamp(6)
  bodega              bodega   @relation(fields: [bodega_id], references: [id], map: "fk_stock_bodega")
  producto            producto @relation(fields: [producto_id], references: [id], map: "fk_stock_producto")

  @@unique([producto_id, bodega_id], map: "uq_stock_producto_bodega")
  @@index([bodega_id], map: "idx_stock_bodega")
  @@index([producto_id], map: "idx_stock_producto")
}

model usuario {
  id                    Int                     @id @default(autoincrement())
  nombre_completo       String                  @db.VarChar(150)
  correo_electronico    String                  @unique(map: "uq_usuario_correo") @db.VarChar(150)
  password_hash         String                  @db.VarChar(255)
  rol                   rol_usuario
  activo                Boolean                 @default(true)
  fecha_creacion        DateTime                @default(now()) @db.Timestamp(6)
  movimiento_inventario movimiento_inventario[]
  recepcion_mercaderia  recepcion_mercaderia[]
  venta                 venta[]
}

model venta {
  id                      Int                      @id @default(autoincrement())
  numero_secuencial       String                   @unique(map: "uq_venta_numero_secuencial") @db.VarChar(50)
  cliente_id              Int?
  usuario_id              Int
  bodega_id               Int
  fecha                   DateTime                 @default(now()) @db.Timestamp(6)
  modalidad_venta         modalidad_venta_enum
  subtotal                Decimal                  @db.Decimal(12, 2)
  iva                     Decimal                  @db.Decimal(12, 2)
  total                   Decimal                  @db.Decimal(12, 2)
  estado                  estado_venta_enum        @default(REGISTRADA)
  comprobante_electronico comprobante_electronico?
  detalle_venta           detalle_venta[]
  bodega                  bodega                   @relation(fields: [bodega_id], references: [id], map: "fk_venta_bodega")
  cliente                 cliente?                 @relation(fields: [cliente_id], references: [id], map: "fk_venta_cliente")
  usuario                 usuario                  @relation(fields: [usuario_id], references: [id], map: "fk_venta_usuario")

  @@index([bodega_id], map: "idx_venta_bodega")
  @@index([cliente_id], map: "idx_venta_cliente")
  @@index([fecha], map: "idx_venta_fecha")
  @@index([usuario_id], map: "idx_venta_usuario")
}

enum estado_comprobante_enum {
  PENDIENTE
  AUTORIZADO
  RECHAZADO
}

enum estado_venta_enum {
  REGISTRADA
  ANULADA
}

enum modalidad_venta_enum {
  AL_POR_MENOR
  AL_POR_MAYOR
}

enum referencia_movimiento_enum {
  VENTA
  RECEPCION
  AJUSTE_MANUAL
}

enum rol_usuario {
  ADMINISTRADOR
  PUNTO_VENTA
  BODEGA
}

enum tipo_identificacion_enum {
  CEDULA
  RUC
  PASAPORTE
  CONSUMIDOR_FINAL
}

enum tipo_movimiento_enum {
  ENTRADA
  SALIDA
  AJUSTE
}

enum tipo_venta_enum {
  PAQUETE
  PESO
}
